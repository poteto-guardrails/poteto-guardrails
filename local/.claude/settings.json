{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 .claude/tools/check.py)",
      "Bash(python3 .claude/tools/check.py --status)",
      "Bash(python3 .claude/tools/verify.py *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Bash(*claude-guardrails*)",
      "Edit(/.git/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(gh pr merge *)",
      "Bash(glab mr merge *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(twine upload*)",
      "Bash(cargo publish*)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/.gitlab-ci.yml)",
      "Edit(/.pre-commit-config.yaml)",
      "Edit(/.husky/**)",
      "Edit(**/.eslintrc*)",
      "Edit(**/eslint.config.*)",
      "Edit(**/.prettierrc*)",
      "Edit(**/tsconfig*.json)",
      "Edit(**/.dependency-cruiser*)",
      "Edit(**/biome.json*)",
      "Edit(**/ruff.toml)",
      "Edit(**/.ruff.toml)",
      "Edit(**/mypy.ini)",
      "Edit(**/pyproject.toml)",
      "Edit(**/setup.cfg)",
      "Edit(**/.golangci.y*ml)",
      "Edit(**/clippy.toml)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_suppressions.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_check.py\"", "timeout": 120 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_gate.py\"", "timeout": 900 }
        ]
      }
    ]
  }
}
