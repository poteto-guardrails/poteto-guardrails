# Guardrail configuration. Owned by humans; Claude needs approval to edit this file.
# Plain KEY=VALUE lines. Values are shell commands run from the repository root.
# Leave a value empty to switch that check off. The session-start hook tells Claude what is switched off.

# Runs after every edit to a matching file. {file} is replaced with the edited file's path.
# Keep it fast (a few seconds): lint plus format check on one file.
# Examples:
#   FAST_CHECK_CMD=npx eslint --max-warnings=0 {file}
#   FAST_CHECK_CMD=ruff check {file} && ruff format --check {file}
FAST_CHECK_CMD=
# Comma-separated globs that FAST_CHECK_CMD applies to.
FAST_CHECK_GLOBS=*.ts,*.tsx,*.js,*.jsx,*.py
FAST_CHECK_TIMEOUT=60

# The full check. Claude runs it with .claude/tools/check.py; the stop gate re-runs it
# if the working tree changed since the last passing run.
# Everything a merge would require: lint, type-check, tests, build.
# Examples:
#   FULL_CHECK_CMD=npm run lint && npx tsc --noEmit && npm test
#   FULL_CHECK_CMD=ruff check . && mypy . && pytest -q
FULL_CHECK_CMD=
FULL_CHECK_TIMEOUT=840
# How many times the stop gate sends Claude back to fix failures before it lets the turn end (it then tells you).
STOP_GATE_MAX_RETRIES=2

# Driver for runtime verification. Must implement the contract described at the top of
# .claude/tools/verify.py (called as: <DRIVER_CMD> --feature ID --scenario ID --out DIR).
# Reference implementation: examples/driver_stub.py
# Example: DRIVER_CMD=python3 examples/driver_stub.py
DRIVER_CMD=
DRIVER_TIMEOUT=300

# Comma-separated generated-artifact paths ignored when deciding whether the working tree changed.
# Keep source, tests and other project-owned files fingerprinted. Only exclude generated evidence.
FINGERPRINT_EXCLUDE=.claude/verification-runs

# Optional. Replace the built-in regex of suppression markers that Claude may not add.
# Leave empty to use the defaults in .claude/hooks/block_suppressions.py.
SUPPRESSION_REGEX=
# Comma-separated globs where adding suppression markers is allowed (for example vendored code).
SUPPRESSION_EXEMPT_GLOBS=.claude/**
