# Global guardrail defaults for every project. Owned by you; Claude needs approval to edit this file.
# A repo's .claude/guardrails.env overrides any key here (an empty value there switches a check off).
# Plain KEY=VALUE lines. Commands run from the repository root.
# Template with explanations for each key: ~/.claude/guardrails/templates/guardrails.env

# Check commands are per-repo; set them in <repo>/.claude/guardrails.env.
FAST_CHECK_CMD=
FAST_CHECK_GLOBS=*.ts,*.tsx,*.js,*.jsx,*.py
FAST_CHECK_TIMEOUT=60
FULL_CHECK_CMD=
FULL_CHECK_TIMEOUT=840
STOP_GATE_MAX_RETRIES=2
DRIVER_CMD=
DRIVER_TIMEOUT=300
FINGERPRINT_EXCLUDE=.claude/verification-runs
SUPPRESSION_REGEX=
SUPPRESSION_EXEMPT_GLOBS=.claude/**
